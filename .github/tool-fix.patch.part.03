+def git_status_paths(lines: Iterable[str]) -> set[str]:
+    paths: set[str] = set()
+    for line in lines:
+        raw = line[3:].strip().split(" -> ")[-1].strip('"').replace("\\", "/")
+        if raw:
+            paths.add(raw)
+    return paths
+
