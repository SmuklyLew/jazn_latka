@@ -0,0 +1,44 @@
+from __future__ import annotations
+
+from typing import Any
+
+from latka_jazn.core.free_dialogue_synthesizer import FreeDialogueSynthesizer
+from latka_jazn.core.json_types import json_object
+from latka_jazn.core.route_handler_base import RouteHandlerResult
+from latka_jazn.version import generation_mode, schema_version
+
+
+class MemoryExperienceRecallHandler:
+    name = "MemoryExperienceRecallHandler"
+    route = "memory_experience_recall"
+    handled_intents = ("memory_experience_question", "substantive_question_about_last_year")
+
+    def handle(self, text: str, context: dict[str, Any] | None = None) -> RouteHandlerResult:
+        ctx = context or {}
+        intent = str(ctx.get("intent") or "memory_experience_question")
+        memory_context = json_object(ctx.get("memory_context"))
+        body = FreeDialogueSynthesizer().synthesize_memory_experience(memory_context, user_text=text).body
+        payload = json_object(memory_context.get("memory_recall_payload"))
+        items = [item for item in (payload.get("items") or []) if isinstance(item, dict)]
+        required = list(ctx.get("required_components") or [])
+        satisfied = ["memory_content", "source_or_index_status", "truth_boundary", "no_current_turn_echo"]
+        if not items:
+            # Empty retrieval is still a truthful grounded result, not permission to fabricate.
+            satisfied = ["source_or_index_status", "truth_boundary", "no_current_turn_echo"]
+        return RouteHandlerResult(
+            self.name,
+            self.route,
+            body,
+            intent=intent,
+            generation_mode="handler_generated",
+            data={"memory_recall_payload": payload, "memory_item_count": len(items)},
+            memory_sources=items,
+            required_components=required,
+            satisfied_components=satisfied,
+            confidence=0.9 if items else 0.68,
+            source_origin_detail=schema_version("memory_experience_recall_handler"),
+            truth_boundary=(
+                "Wspomnienia są renderowane wyłącznie z bieżącego, źródłowo uziemionego payloadu recall; "
+                "brak trafień nie uprawnia do konfabulacji."
+            ),
+        )
