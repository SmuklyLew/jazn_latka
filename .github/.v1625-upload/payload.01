@@ -0,0 +1,89 @@
+from __future__ import annotations
+
+from datetime import datetime, timezone
+import re
+from zoneinfo import ZoneInfo
+
+_DIACRITIC_MAP = str.maketrans("ąćęłńóśźżĄĆĘŁŃÓŚŹŻ", "acelnoszzACELNOSZZ")
+
+# One canonical set shared by the classifier/gate/NLG/host-generation path.
+# These intents are allowed to consume autobiographical/source-backed memory content.
+MEMORY_CONTENT_INTENTS = frozenset({
+    "memory_recall_request",
+    "self_memory_recall_request",
+    "user_memory_recall_request",
+    "memory_experience_question",
+    "substantive_question_about_last_year",
+    "identity_memory_existence_compound_question",
+    "identity_memory_question",
+    "user_memory_question",
+    "question_about_memory",
+    "question_about_time_memory_and_experience",
+    "continuity_question",
+})
+
+# Folded Polish stems deliberately cover inflectional forms such as
+# powspominaj/wspominasz/wspominaliśmy and pamiętasz/pamięci.
+_RECALL_STEMS = (
+    "pamiet",
+    "wspomin",
+    "wspomn",
+    "przypomn",
+)
+_RECALL_PHRASES = (
+    "historia rozmow",
+    "archiwum rozmow",
+    "archiwum czatow",
+    "odzyskaj historie",
+    "odzyskac historie",
+    "odtworz historie",
+    "odtworzyc historie",
+)
+_YEAR_RE = re.compile(r"(?<!\d)(20\d{2})(?!\d)")
+
+
+def fold_memory_text(text: str) -> str:
+    value = re.sub(r"\s+", " ", str(text or "").strip().lower()).translate(_DIACRITIC_MAP)
+    return value
+
+
+def has_explicit_memory_recall(text: str) -> bool:
+    folded = fold_memory_text(text)
+    if any(phrase in folded for phrase in _RECALL_PHRASES):
+        return True
+    tokens = re.findall(r"[a-z0-9_-]+", folded)
+    return any(stem in token for token in tokens for stem in _RECALL_STEMS)
+
+
+def extract_year(text: str) -> int | None:
+    folded = fold_memory_text(text)
+    match = _YEAR_RE.search(folded)
+    if not match:
+        return None
+    year = int(match.group(1))
+    if not (2000 <= year <= 2100):
+        return None
+    return year
+
+
+def temporal_scope_for_query(text: str, *, timezone_name: str = "Europe/Warsaw") -> dict[str, object]:
+    year = extract_year(text)
+    if year is None:
+        return {}
+    # A bare build/version number must not silently become autobiographical time.
+    folded = fold_memory_text(text)
+    temporal_language = has_explicit_memory_recall(text) or any(
+        marker in folded for marker in ("roku", "rok ", f"z {year}", f"w {year}", f"caly {year}", f"calego {year}")
+    )
+    if not temporal_language:
+        return {}
+    zone = ZoneInfo(timezone_name)
+    start_local = datetime(year, 1, 1, tzinfo=zone)
+    end_local = datetime(year + 1, 1, 1, tzinfo=zone)
+    return {
+        "kind": "calendar_year",
+        "year": year,
+        "timezone": timezone_name,
+        "start_utc": start_local.astimezone(timezone.utc).isoformat(),
+        "end_utc": end_local.astimezone(timezone.utc).isoformat(),
+    }
