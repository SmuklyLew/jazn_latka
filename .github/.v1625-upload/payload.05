)
+
+    assert gate.allow_memory_content is True
+    assert plan.memory_policy == "required_grounded_payload"
+    assert plan.answer_kind == "memory_grounded_answer"
+
+    allowed = extract_allowed_memory_items(
+        {
+            "items": [
+                {
+                    "item_id": "m-2025",
+                    "content_excerpt": "W lipcu 2025 rozmawialiśmy o książce i ilustracjach.",
+                    "source": "conversation_archive",
+                    "timestamp": "2025-07-23T05:41:01+00:00",
+                    "confidence": 0.9,
+                    "meaning_assessment": "source-backed",
+                }
+            ]
+        },
+        plan,
+    )
+    assert [item["item_id"] for item in allowed] == ["m-2025"]
+
+
+def test_memory_experience_has_dedicated_grounded_handler() -> None:
+    registry = RouteRegistry()
+    for intent in ("memory_experience_question", "substantive_question_about_last_year"):
+        entry = registry.resolve(intent)
+        assert entry.route == "memory_experience_recall"
+        assert entry.handler_name == "MemoryExperienceRecallHandler"
+        assert "memory_content" in entry.required_components
+
+
+def _make_fts_shard(path: Path) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with sqlite3.connect(path) as con:
+        con.executescript(
+            """
+            CREATE TABLE fts_docs(
+              rowid INTEGER PRIMARY KEY AUTOINCREMENT,
+              fts_doc_uid TEXT NOT NULL UNIQUE,
+              archive_message_uid TEXT NOT NULL,
+              archive_occurrence_uid TEXT NOT NULL,
+              staging_uid TEXT NOT NULL,
+              conversation_uid TEXT NOT NULL,
+              source_uid TEXT NOT NULL,
+              role TEXT,
+              title TEXT,
+              create_time TEXT,
+              content_hash TEXT NOT NULL
+            );
+            CREATE VIRTUAL TABLE message_fts USING fts5(text, content='', tokenize='unicode61 remove_diacritics 2');
+            """
+        )
+        rows = [
+            ("doc-2024", "2024-12-01T12:00:00+00:00", "poza zakresem"),
+            ("doc-early", "1736942400.0", "styczeń 2025"),
+            ("doc-mid", "2025-07-23T05:41:01+00:00", "lipiec 2025 książka"),
+            ("doc-late", "1767189600.0", "grudzień 2025"),
+            ("doc-2026", "2026-01-10T12:00:00+00:00", "poza zakresem"),
+        ]
+        for index, (uid, created, text) in enumerate(rows, start=1):
+            con.execute(
+                "INSERT INTO fts_docs(fts_doc_uid,archive_message_uid,archive_occurrence_uid,staging_uid,conversation_uid,source_uid,role,title,create_time,content_hash) VALUES(?,?,?,?,?,?,?,?,?,?)",
+                (uid, f"m{index}", f"o{index}", f"st{index}", "conv", "src", "user", uid, created, f"h{index}"),
+            )
+            rowid = con.execute("SELECT rowid FROM fts_docs WHERE fts_doc_uid=?", (uid,)).fetchone()[0]
+            con.execute("INSERT INTO message_fts(rowid,text) VALUES(?,?)", (rowid, text))
+
+
+@dataclass
+class _Status:
+    ready_for_search: bool = True
+    issues: list[str] = None  # type: ignore[assignment]
+
+    def __post_init__(self) -> None:
+        if self.issues is None:
+            self.issues = []
+
+
+@dataclass
+class _Hit:
+    payload: dict
+
+    def to_dict(self) -> dict:
+        return self.payload
+
+
+def test_conversation_archive_time_only_search_supports_epoch_and_iso(monkeypatch, tmp_path: Path) -> None:
+    store = ConversationArchiveStore(tmp_path)
+    shard = store.fts_dir / "fts.sqlite3"
+    _make_fts_shard(shard)
+
+    monkeypatch.setattr(store, "status", lambda **_: _Status())
+    monkeypatch.setattr(
+        store,
+        "_manifest_rows",
+        lambda *_args, **_kwargs: [{"family": "fts", "relative_path": "fts.sqlite3", "shard_id": "fts_1"}],
+    )
+    monkeypatch.setattr(
+        store,
+        "_hydrate_hit",
+        lambda row, **_: _Hit({"fts_doc_uid": row["fts_doc_uid"], "create_time": row["create_time"]}),
+    )
+
+    result = store.search(
+        "",
+        limit=8,
+        start_time_utc="2024-12-31T23:00:00+00:00",
+        end_time_utc="2025-12-31T23:00:00+00:00",
+    )
+
+    assert result.status == "ok"
+    assert {hit["fts_doc_uid"] for hit in result.hits} == {"doc-early", "doc-mid", "doc-late"}
+    assert result.fts_query is None
+
+
+def test_runtime_repair_synthesizer_keeps_real_memory_context() -> None:
+    context = {
+        "query_terms": ["książka"],
+        "conversation_archive_hits": [
+            {
+                "excerpt": "W lipcu wracaliśmy do książki i ilustracji rozdziałów.",
+                "create_time": "2025-07-23T05:41:01+00:00",
+                "source_name": "chat export",
+                "identity_confidence": 0.9,
+            }
+        ],
+    }
+    result = RuntimeResponseSynthesizer().synthesize(
+        user_text="Co wspominasz z 2025 roku o książce?",
+        detected_intent="memory_experience_question",
+        original_body="nietrafny fallback",
+        route="memory_experience_recall",
+        validation={"must_regenerate": True},
+        memory_context=context,
+    )
+
+    assert result.should_override is True
+    assert "książ" in result.body.lower()
+    assert "nie znalazłam teraz" not in result.body.lower()
+
+
+def test_canonical_memory_plan_subcommand_routes_to_diagnostic(monkeypatch, tmp_path: Path) -> None:
+    captured: list[str] = []
+
+    def fake_legacy(args: list[str]) -> int:
+        captured.extend(args)
+        return 0
+
+    monkeypatch.setattr(cli, "_legacy_main", fake_legacy)
+    rc = cli.main(["memory-plan", "--root", str(tmp_path), QUERY_2025])
+
+    assert rc == 0
+    assert "--memory-plan" in captured
+    assert "memory-plan" not in captured
+    assert QUERY_2025 in captured
