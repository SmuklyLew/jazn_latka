--- /dev/null
+++ b/tests/test_v1625_memory_recall_neurology_hardening.py
@@ -0,0 +1,210 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+import sqlite3
+
+from latka_jazn import cli
+from latka_jazn.core.memory_intent_contract import has_explicit_memory_recall
+from latka_jazn.core.memory_search_planner import MemorySearchPlanner
+from latka_jazn.core.memory_use_gate import MemoryUseGate
+from latka_jazn.core.model_context_compiler import extract_allowed_memory_items
+from latka_jazn.core.nlg_planner import build_nlg_plan
+from latka_jazn.core.route_registry import RouteRegistry
+from latka_jazn.core.runtime_response_synthesizer import RuntimeResponseSynthesizer
+from latka_jazn.memory.conversation_archive import ConversationArchiveStore
+from latka_jazn.nlp.dialogue_intent_classifier import DialogueIntentClassifier
+
+
+QUERY_2025 = "Proszę, powspominaj wszystko co możesz z 2025 roku."
+
+
+def test_polish_powspominaj_beats_ambiguous_capability_marker() -> None:
+    report = DialogueIntentClassifier().classify(QUERY_2025)
+
+    assert has_explicit_memory_recall(QUERY_2025) is True
+    assert report.primary_intent == "memory_experience_question"
+    assert report.primary_intent != "capability_status_question"
+
+
+def test_memory_planner_treats_year_as_temporal_scope_not_fts_token(tmp_path: Path) -> None:
+    plan = MemorySearchPlanner(tmp_path).plan(QUERY_2025)
+
+    assert plan.recall_requested is True
+    assert plan.temporal_scope["year"] == 2025
+    assert plan.temporal_scope["timezone"] == "Europe/Warsaw"
+    assert plan.temporal_scope["start_utc"] == "2024-12-31T23:00:00+00:00"
+    assert plan.temporal_scope["end_utc"] == "2025-12-31T23:00:00+00:00"
+    assert "2025" not in plan.search_terms
+    assert "roku" not in plan.search_terms
+    assert "powspominaj" not in plan.search_terms
+
+
+def test_memory_gate_and_nlg_share_grounded_memory_intent_contract() -> None:
+    intent = "memory_experience_question"
+    gate = MemoryUseGate().decide(QUERY_2025, detected_intent=intent)
+    route = RouteRegistry().resolve(intent)
+    plan = build_nlg_plan(
+        user_text=QUERY_2025,
+        cognitive_frame={"memory_gate": "not_needed", "semantic_frame": {"primary_intent": intent}},
+        response_policy={},
+        route=route.route,
+        detected_intent=intent,
+        model_adapter_status={},
+    