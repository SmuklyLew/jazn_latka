                         d = dict(row)
                         key = f"{d.get('conversation_id')}:{d.get('author_role')}:{d.get('create_time_warsaw')}:{str(d.get('text') or '')[:80]}"
                         if key in seen_legacy:
@@ -1397,7 +1416,9 @@ class JaznEngine:
