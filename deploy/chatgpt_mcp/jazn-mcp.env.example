# Copy outside the repository and protect file permissions.
JAZN_MCP_OAUTH_CLIENT_ID=
JAZN_MCP_OAUTH_CLIENT_SECRET=
JAZN_MCP_OAUTH_ISSUER_URL=https://id.example.com/
JAZN_MCP_OAUTH_RESOURCE_SERVER_URL=https://jazn.example.com/mcp
JAZN_MCP_OAUTH_INTROSPECTION_URL=https://id.example.com/oauth2/introspect
JAZN_MCP_ALLOWED_HOSTS=jazn.example.com
JAZN_MCP_ALLOWED_ORIGINS=https://chatgpt.com
JAZN_MCP_REQUIRE_SUPERVISOR=1

# Cloudflare Tunnel token belongs in the shell/secret store used by Compose,
# not in this file when the file may be copied or committed.
# CLOUDFLARE_TUNNEL_TOKEN=
