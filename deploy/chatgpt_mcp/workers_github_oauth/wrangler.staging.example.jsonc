{
  // TEMPLATE ONLY: copy to wrangler.staging.jsonc after creating a DIFFERENT
  // KV namespace and GitHub OAuth App. This file MUST NOT be deployed as-is.
  "name": "jazn-auth-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [
    {"binding":"OAUTH_KV","id":"REPLACE_WITH_NEW_ISOLATED_STAGING_KV_ID"}
  ],
  "vars": {
    "JAZN_AUTH_ENVIRONMENT": "staging",
    "JAZN_OAUTH_ISSUER_URL": "https://jazn-auth-staging.jazn-lakta.workers.dev",
    "JAZN_OAUTH_RESOURCE_URL": "https://jazn-runtime-staging.jazn-lakta.workers.dev/mcp"
  }
}
