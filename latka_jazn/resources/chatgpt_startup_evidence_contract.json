{
  "schema_version": "jazn_chatgpt_startup_evidence/v1",
  "role": "host_bootstrap_discovery_evidence_not_runtime_authority",
  "required_current_message_tools": [
    "jazn_status",
    "jazn_generate_visible_reply",
    "jazn_resume_visible_reply",
    "jazn_finalize_reply"
  ],
  "tool_discovery": {
    "name_matching": "exact_callable_tool_name",
    "description_regex_sufficient": false,
    "installed_or_catalog_sufficient": false,
    "fresh_jazn_status_required": true,
    "complete_toolset_required_for_remote_only": true,
    "complete_toolset_required_for_local_bootstrap": false,
    "mcp_registration_requires_host_connection": true
  },
  "file_discovery": {
    "surfaces": [
      "conversation",
      "project",
      "library"
    ],
    "pagination_required_when_cursor_present": true,
    "requested_version_must_match_selected_package": true,
    "sidecars_must_match_archive_identity": true,
    "file_id_source": "actual_current_files_search_or_list_result",
    "file_id_guessing_allowed": false,
    "version_id_preserved_when_present": true,
    "file_id_is_os_path": false
  },
  "materialization": {
    "request_uses_exact_discovered_file_id": true,
    "request_binds_version_id_when_present": true,
    "missing_or_empty_artifacts_result": "failed",
    "callable_interface_is_success": false,
    "artifact_result_is_integrity_evidence": false,
    "physical_path_and_byte_size_required": true,
    "trusted_sha256_required_before_bootstrap": true,
    "zip_catalog_crc_path_checks_required": true,
    "extractall_raw_allowed": false
  },
  "readiness_sequence": [
    "current_message_remote_gate",
    "bounded_executor_probe_if_remote_not_ready",
    "system_discovery_and_exact_id_binding",
    "materialization_receipts",
    "physical_file_size_and_trusted_sha256",
    "zip_catalog_crc_and_safe_bootstrap",
    "materialized_operator_ready",
    "AGENTS.md",
    "AGENTS.chatgpt.md",
    "host_preflight",
    "daemon_live_status",
    "one_bound_runtime_turn",
    "accepted_display_exact_finalization"
  ],
  "diagnostics": {
    "required_tri_state_fields": [
      "executor_available",
      "library_search_available",
      "library_materialize_available",
      "system_search_attempted",
      "system_candidate_found",
      "remote_runtime_available"
    ],
    "unknown_when_no_observation": true,
    "positive_executor_requires_process_created": true,
    "positive_remote_requires_live_status_and_complete_toolset": true,
    "no_fabricated_tool_citations": true,
    "no_claim_of_matched_archives_from_sidecars_alone": true,
    "prespawn_client_error_is_runtime_error": false,
    "host_probe_elapsed_time_is_failure_evidence": false,
    "model_identity_requires_host_evidence": true,
    "callable_materialization_interface_proves_bytes": false
  },
  "truth_boundary": "This manifest is release/startup policy, not a host tool-call result. A ZIP, sidecar, installed app, or callable Files interface cannot prove a materialized artifact, executable host, live Jaźń runtime or accepted visible reply.",
  "local_bootstrap": {
    "requires_host_process_creation": true,
    "requires_remote_mcp_tools": false,
    "system_zip_integrity_before_execution": true,
    "project_loader_can_guarantee_host_probe_wallclock_timeout": false,
    "on_pre_spawn_client_error": "surface_generation_unavailable_do_not_replay_or_imply_python_executed"
  },
  "pre_post_materialization_capabilities": {
    "before_unpack": [
      "observe_full_callable_remote_turn_toolset",
      "bounded_primary_executor_process_creation",
      "bounded_single_independent_executor_alternative",
      "discover_conversation_project_library_files"
    ],
    "after_unpack": [
      "verify_materialized_operator_ready",
      "run_canonical_preflight_start_live_status",
      "record_new_host_surface_capabilities_separately",
      "bind_once_and_finalize_exactly_one_turn"
    ],
    "prohibited_inferences": [
      "zip_or_github_repo_grants_executor",
      "materialized_python_grants_mcp_tools",
      "cloudflare_503_is_runtime_ready",
      "clienterror_prespawn_means_filesystem_missing"
    ]
  },
  "memory_continuity_policy": {
    "memory_mode_for_nonblocking_core": "optional",
    "readiness_policy_for_latka_autobiography": "native_unified_required",
    "autobiographical_continuity_requires_verified_memory": true,
    "missing_memory_blocks_core_reasoning": false,
    "claims_require": [
      "full_autobiographical_recall_ready",
      "continuity_ready",
      "local_memory_provenance"
    ],
    "explicit_required_mode_may_override_core_readiness": true
  },
  "http_tasks_dispatch": {
    "sync_backend_off_asgi_event_loop": true,
    "offload_method": "starlette.concurrency.run_in_threadpool",
    "runtime_request_retries_by_transport": 0,
    "host_prespawn_error_fixed_by_offload": false,
    "worker_cancel_is_not_backend_cancellation": true,
    "truth_boundary": "Thread offload keeps the gateway responsive but does not cancel already started work or guarantee ChatGPT host execution; durable request_id and explicit resume/finalize remain authoritative."
  }
}
